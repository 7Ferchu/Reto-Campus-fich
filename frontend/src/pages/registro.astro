---
import Layout from '@/layouts/Layout.astro';
---
<Layout title="Registro | Campus FICH"><section class="min-h-screen bg-ink px-5 pb-20 pt-36"><div class="mx-auto max-w-2xl"><p class="font-display text-xl uppercase tracking-widest text-lime">Únete a la comunidad</p><h1 class="font-display text-6xl font-black uppercase">Crear cuenta</h1><div class="panel mt-8"><form id="form" class="grid gap-5 sm:grid-cols-2"><label class="text-sm font-semibold">Nombres<input class="field" name="nombres" /></label><label class="text-sm font-semibold">Apellidos<input class="field" name="apellidos" /></label><label class="text-sm font-semibold sm:col-span-2">Correo<input class="field" name="correo" type="email" /></label><label class="text-sm font-semibold">Contraseña<input class="field" name="contrasena" type="password" /></label><label class="text-sm font-semibold">Tipo<select class="field" name="tipo_usuario"><option value="estudiante">Estudiante</option><option value="docente">Docente</option><option value="administrativo">Administrativo</option><option value="externo">Externo</option></select></label><label id="code" class="text-sm font-semibold sm:col-span-2">CodigoFICH<input class="field" name="codigo_fich" /></label><div class="sm:col-span-2"><p id="message" class="min-h-5 text-sm text-red-300"></p><button class="btn-primary w-full">Crear cuenta</button></div></form></div></div></section></Layout>
<script>
  import { post } from '@/lib/api'; import { registerSchema } from '@/lib/validators';
  const form = document.querySelector('form')!; const message = document.querySelector('#message'); const type = form.elements.namedItem('tipo_usuario') as HTMLSelectElement; const code = document.querySelector('#code');
  const toggle = () => code?.classList.toggle('hidden', ['administrativo','externo'].includes(type.value)); type.addEventListener('change', toggle); toggle();
  form.addEventListener('submit', async (event) => { event.preventDefault(); const parsed = registerSchema.safeParse(Object.fromEntries(new FormData(form))); if (!parsed.success) { message!.textContent = parsed.error.issues[0].message; return; } try { await post('/solicitantes', { ...parsed.data, codigo_fich: parsed.data.codigo_fich || null }); location.href = '/login'; } catch (e) { message!.textContent = e instanceof Error ? e.message : 'No fue posible registrarte'; } });
</script>

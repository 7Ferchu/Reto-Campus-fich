---
import Layout from '@/layouts/Layout.astro';
---
<Layout title="Mis reservas | Campus FICH"><section class="min-h-screen bg-ink px-5 pb-20 pt-36"><div class="container-page"><div class="flex flex-wrap items-end justify-between gap-5"><div><p class="font-display text-xl uppercase tracking-widest text-lime">Área personal</p><h1 class="font-display text-6xl font-black uppercase">Mis reservas</h1></div><a class="btn-primary" href="/reservas/nueva">Nueva reserva +</a></div><div id="list" class="mt-10 grid gap-4 md:grid-cols-2"><p class="text-mist/70">Cargando...</p></div></div></section></Layout>
<script>
  import { get, patch } from '@/lib/api'; import { requireSession } from '@/lib/guard'; import type { Reservation } from '@/types/api'; requireSession('solicitante');
  const list = document.querySelector('#list'); const load = async () => { try { const rows = await get<Reservation[]>('/reservas/mis-reservas'); list!.innerHTML = rows.length ? rows.map((r) => `<article class="panel"><p class="text-sm text-lime">${r.fecha_reserva}</p><h2 class="mt-1 text-xl font-bold">${r.cancha?.nombre || 'Cancha Campus FICH'}</h2><p class="mt-2 text-sm text-mist/70">${r.horario?.dia_semana || ''} · ${r.horario?.hora_inicio || ''} - ${r.horario?.hora_fin || ''}</p><span class="mt-4 inline-block rounded-full bg-lime/10 px-3 py-1 text-xs text-lime">${r.estado}</span>${r.estado === 'confirmada' ? `<button data-id="${r.id_reserva}" class="mt-4 block text-sm text-red-300">Cancelar reserva</button>` : ''}</article>`).join('') : '<p class="text-mist/70">No tienes reservas registradas.</p>'; list!.querySelectorAll('button').forEach((b) => b.addEventListener('click', async () => { await patch(`/reservas/${(b as HTMLElement).dataset.id}/cancelar`); load(); })); } catch (e) { list!.innerHTML = `<p class="text-red-300">${e instanceof Error ? e.message : 'No fue posible cargar tus reservas'}</p>`; } }; load();
</script>

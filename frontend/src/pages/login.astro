---
import Layout from '@/layouts/Layout.astro';
---
<Layout title="Iniciar sesión | Campus FICH"><section class="min-h-screen bg-ink px-5 pb-20 pt-36"><div class="mx-auto max-w-md"><p class="font-display text-xl uppercase tracking-widest text-lime">Bienvenido</p><h1 class="font-display text-6xl font-black uppercase">Iniciar sesión</h1><div class="panel mt-8"><form id="form" class="space-y-5"><label class="block text-sm font-semibold">Usuario o correo<input class="field" name="identificador" placeholder="IngFer o correo@fich.edu.co" /></label><label class="block text-sm font-semibold">Contraseña<input class="field" name="contrasena" type="password" /></label><p id="message" class="min-h-5 text-sm text-red-300"></p><button class="btn-primary w-full" type="submit">Ingresar</button></form><p class="mt-6 text-center text-sm text-mist/70">¿No tienes cuenta? <a class="text-lime" href="/registro">Regístrate</a></p></div></div></section></Layout>
<script>
  import { post } from '@/lib/api'; import { saveSession } from '@/lib/session'; import { loginSchema } from '@/lib/validators'; import type { AuthData } from '@/types/api';
  const form = document.querySelector('form')!; const message = document.querySelector('#message');
  form.addEventListener('submit', async (event) => { event.preventDefault(); const v = Object.fromEntries(new FormData(form)); const parsed = loginSchema.safeParse(v); if (!parsed.success) { message!.textContent = parsed.error.issues[0].message; return; } try { const data = await post<AuthData>('/auth/login', { usuario: parsed.data.identificador, correo: parsed.data.identificador, contrasena: parsed.data.contrasena }); saveSession(data); location.href = data.user.rol === 'administrador' ? '/admin' : '/reservas'; } catch (e) { message!.textContent = e instanceof Error ? e.message : 'No fue posible ingresar'; } });
</script>

---
import Layout from '@/layouts/Layout.astro';
---
<Layout title="Campus FICH | Inicio">
  <section class="relative min-h-[720px] overflow-hidden bg-ink pt-20"><div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_50%,rgba(11,93,40,.7),transparent_42%),linear-gradient(115deg,#03131f_0%,#061d2b_52%,#0b5d28_53%,#03131f_54%)]"></div><div class="container-page relative grid min-h-[620px] items-center gap-10 py-20 lg:grid-cols-2"><div class="max-w-xl"><p class="font-display text-2xl font-bold uppercase tracking-widest text-lime">Campus FICH</p><h1 class="mt-3 font-display text-7xl font-black uppercase leading-[.85] sm:text-8xl">Deporte,<br /><span class="text-lime">formación</span><br />y comunidad</h1><p class="mt-7 max-w-md text-lg leading-relaxed text-mist">Un espacio donde el talento se entrena, los valores se viven y la comunidad crece.</p><div class="mt-8 flex flex-wrap gap-4"><a class="btn-primary" href="/registro">Reserva tu cancha →</a><a class="btn-secondary" href="#instalaciones">Conoce nuestras instalaciones</a></div></div><img class="hidden h-[470px] w-full rounded-[3rem] object-cover shadow-neon lg:block" src="/images/hero-campus-fich.svg" alt="Canchas de pasto sintético y cemento" /></div></section>
  <section id="instalaciones" class="bg-ink py-20"><div class="container-page grid gap-5 sm:grid-cols-2 lg:grid-cols-4">{[['⚽','Cancha de fútbol','Pasto sintético'],['🏟','Coliseo polideportivo','Futsal, básquet y más'],['●●●','Espacios seguros','Para toda la comunidad'],['◆','Formación integral','Deporte + valores']].map(([icon,title,text]) => <article class="border-t border-lime/60 py-5"><div class="mb-4 grid h-14 w-14 place-items-center rounded-full border-2 border-lime text-xl text-lime">{icon}</div><h2 class="font-display text-2xl font-bold uppercase">{title}</h2><p class="mt-2 text-sm text-mist/70">{text}</p></article>)}</div></section>
  <section id="actividades" class="bg-midnight py-20"><div class="container-page grid gap-8 md:grid-cols-2"><h2 class="font-display text-6xl font-black uppercase">Entrena.<br /><span class="text-lime">Comparte.</span><br />Crece.</h2><p class="text-lg leading-relaxed text-mist/75">Consulta la disponibilidad y reserva fácilmente las canchas universitarias de Campus FICH.</p></div></section>
</Layout>

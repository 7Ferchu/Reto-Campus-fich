---
import Layout from '@/layouts/Layout.astro';
---
<Layout title="Horarios | Campus FICH"><section class="min-h-screen bg-ink px-5 pb-20 pt-36"><div class="container-page"><a class="text-lime" href="/admin">← Panel</a><h1 class="mt-4 font-display text-6xl font-black uppercase">Horarios</h1><form id="form" class="panel mt-8 grid gap-4 md:grid-cols-5"><input class="field mt-0" name="id_cancha" type="number" placeholder="Cancha #" /><select class="field mt-0" name="dia_semana"><option value="lunes">Lunes</option><option value="martes">Martes</option><option value="miércoles">Miércoles</option><option value="jueves">Jueves</option><option value="viernes">Viernes</option><option value="sábado">Sábado</option></select><input class="field mt-0" name="hora_inicio" type="time" min="07:00" max="21:59" /><input class="field mt-0" name="hora_fin" type="time" min="07:01" max="22:00" /><button class="btn-primary md:col-span-5">Crear horario</button><p id="message" class="text-sm text-red-300 md:col-span-5"></p></form><div id="list" class="mt-10 grid gap-4 md:grid-cols-3"><p>Cargando...</p></div></div></section></Layout>
<script>
  import { get, post, remove } from '@/lib/api'; import { requireSession } from '@/lib/guard'; import { scheduleSchema } from '@/lib/validators'; import type { Schedule } from '@/types/api'; requireSession('administrador');
  const list = document.querySelector('#list')!; const form = document.querySelector<HTMLFormElement>('#form')!; const message = document.querySelector('#message');
  const load = async () => { const rows = await get<Schedule[]>('/horarios'); list.innerHTML = rows.map((r) => `<article class="panel flex items-start justify-between gap-3"><div><p class="text-sm text-lime">${r.dia_semana}</p><h2 class="mt-2 text-xl font-bold">${r.hora_inicio} - ${r.hora_fin}</h2><p class="mt-2 text-sm text-mist/70">Cancha #${r.id_cancha} · ${r.estado}</p></div><button data-delete="${r.id_horario}" class="text-sm text-red-300">Eliminar</button></article>`).join(''); list.querySelectorAll('[data-delete]').forEach((button) => button.addEventListener('click', async () => { await remove(`/horarios/${(button as HTMLElement).dataset.delete}`); load(); })); }; load().catch(() => { list.textContent = 'No fue posible cargar los horarios'; });
  form.addEventListener('submit', async (event) => { event.preventDefault(); const parsed = scheduleSchema.safeParse(Object.fromEntries(new FormData(form))); if (!parsed.success) { message!.textContent = parsed.error.issues[0].message; return; } try { await post('/horarios', parsed.data); form.reset(); message!.textContent = ''; load(); } catch (e) { message!.textContent = e instanceof Error ? e.message : 'No fue posible crear el horario'; } });
</script>

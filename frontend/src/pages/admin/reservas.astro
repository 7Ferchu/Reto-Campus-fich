---
import Layout from '@/layouts/Layout.astro';
---
<Layout title="Gestionar reservas | Campus FICH"><section class="min-h-screen bg-ink px-5 pb-20 pt-36"><div class="container-page"><a class="text-lime" href="/admin">← Panel</a><h1 class="mt-4 font-display text-6xl font-black uppercase">Reservas</h1><div id="list" class="mt-10 grid gap-4"><p>Cargando...</p></div></div></section></Layout>
<script>
  import { get, patch } from '@/lib/api'; import { requireSession } from '@/lib/guard'; import type { Reservation } from '@/types/api'; requireSession('administrador'); const list = document.querySelector('#list');
  try { const rows = await get<Reservation[]>('/reservas/admin'); list!.innerHTML = rows.map((r) => `<article class="panel flex flex-wrap items-center justify-between gap-4"><div><p class="text-sm text-lime">#${r.id_reserva} · ${r.fecha_reserva}</p><h2 class="font-bold">${r.cancha?.nombre || 'Cancha'} · ${r.horario?.hora_inicio || ''}-${r.horario?.hora_fin || ''}</h2><p class="text-sm text-mist/70">Estado: ${r.estado}</p></div><div class="flex gap-2"><button data-id="${r.id_reserva}" data-state="confirmada" class="rounded-full bg-lime px-4 py-2 text-sm font-bold text-ink">Confirmar</button><button data-id="${r.id_reserva}" data-state="rechazada" class="rounded-full border border-red-300 px-4 py-2 text-sm text-red-200">Rechazar</button></div></article>`).join(''); list!.querySelectorAll('button').forEach((b) => b.addEventListener('click', async () => { const el = b as HTMLElement; await patch(`/reservas/admin/${el.dataset.id}/estado`, { estado: el.dataset.state }); location.reload(); })); } catch (e) { list!.innerHTML = `<p class="text-red-300">${e instanceof Error ? e.message : 'No fue posible cargar reservas'}</p>`; }
</script>

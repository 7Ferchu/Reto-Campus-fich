---
import Layout from '@/layouts/Layout.astro';
---
<Layout title="Canchas | Campus FICH"><section class="min-h-screen bg-ink px-5 pb-20 pt-36"><div class="container-page"><a class="text-lime" href="/admin">← Panel</a><h1 class="mt-4 font-display text-6xl font-black uppercase">Canchas</h1><form id="form" class="panel mt-8 grid gap-4 md:grid-cols-3"><input class="field mt-0" name="nombre" placeholder="Nombre de la cancha" /><input class="field mt-0" name="tipo_superficie" placeholder="Tipo de superficie" /><input class="field mt-0" name="descripcion" placeholder="Descripción" /><button class="btn-primary md:col-span-3">Crear cancha</button><p id="message" class="text-sm text-red-300 md:col-span-3"></p></form><div id="list" class="mt-10 grid gap-5 md:grid-cols-2"><p>Cargando...</p></div></div></section></Layout>
<script>
  import { get, post, remove } from '@/lib/api'; import { requireSession } from '@/lib/guard'; import { courtSchema } from '@/lib/validators'; import type { Court } from '@/types/api'; requireSession('administrador');
  const list = document.querySelector('#list')!; const form = document.querySelector<HTMLFormElement>('#form')!; const message = document.querySelector('#message');
  const load = async () => { const rows = await get<Court[]>('/canchas'); list.innerHTML = rows.map((r) => `<article class="panel flex items-start justify-between gap-4"><div><p class="text-sm uppercase tracking-widest text-lime">${r.tipo_superficie}</p><h2 class="mt-2 text-2xl font-bold">${r.nombre}</h2><p class="mt-2 text-sm text-mist/70">${r.descripcion || ''}</p></div><button data-delete="${r.id_cancha}" class="text-sm text-red-300">Eliminar</button></article>`).join(''); list.querySelectorAll('[data-delete]').forEach((button) => button.addEventListener('click', async () => { await remove(`/canchas/${(button as HTMLElement).dataset.delete}`); load(); })); }; load().catch(() => { list.textContent = 'No fue posible cargar las canchas'; });
  form.addEventListener('submit', async (event) => { event.preventDefault(); const parsed = courtSchema.safeParse(Object.fromEntries(new FormData(form))); if (!parsed.success) { message!.textContent = parsed.error.issues[0].message; return; } try { await post('/canchas', parsed.data); form.reset(); message!.textContent = ''; load(); } catch (e) { message!.textContent = e instanceof Error ? e.message : 'No fue posible crear la cancha'; } });
</script>

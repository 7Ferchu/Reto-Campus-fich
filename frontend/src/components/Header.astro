<header class="absolute inset-x-0 top-0 z-20 border-b border-white/10 bg-ink/80 backdrop-blur-md"><div class="container-page flex h-20 items-center justify-between"><a href="/" class="flex items-center gap-3"><span class="grid h-11 w-11 place-items-center rounded-full border-2 border-lime text-xl">⚽</span><span class="font-display text-2xl font-extrabold uppercase">Campus <span class="text-lime">FICH</span></span></a><nav class="hidden gap-8 text-sm font-semibold md:flex"><a class="text-lime" href="/">Inicio</a><a class="hover:text-lime" href="/#instalaciones">Instalaciones</a><a class="hover:text-lime" href="/#actividades">Actividades</a><a class="hover:text-lime" href="/#contacto">Contacto</a></nav><a id="auth-link" href="/login" class="rounded-full border border-lime px-4 py-2 text-sm font-bold text-lime transition hover:bg-lime hover:text-ink">Ingresar</a></div></header>
<script>import { post } from '@/lib/api'; import { clearSession, getSession } from '@/lib/session'; const link = document.querySelector<HTMLAnchorElement>('#auth-link'); if (getSession() && link) { link.textContent = 'Cerrar sesión'; link.href = '#'; link.addEventListener('click', async (event) => { event.preventDefault(); await post('/auth/logout', {}).catch(() => undefined); clearSession(); location.href = '/'; }); }</script>
